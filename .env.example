# Copia este archivo a .env.local (local) y configura las mismas variables en Vercel.
# Sin Supabase configurado la app arranca en MODO DEMO con datos en memoria.

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo servidor (agente, webhook, crons). Nunca la expongas en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Fuerza el modo demo aunque haya credenciales (1 = sí)
DEMO_MODE=

# ── OpenAI (agente) ────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Opcional: modelo para verificar fotos de evidencia (visión)
OPENAI_VISION_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# low | medium | high (sólo modelos de razonamiento)
OPENAI_REASONING_EFFORT=low

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto libre que eliges y pegas en Meta → Webhooks → Verify token
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta (valida la firma X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Plantilla aprobada con un parámetro {{1}} para alertas fuera de la ventana de 24 h
WHATSAPP_ALERT_TEMPLATE=rhino_alerta
WHATSAPP_TEMPLATE_LANG=es_MX

# ── App ────────────────────────────────────────────────────────────────────
# URL pública (para los enlaces del wizard que se envían por WhatsApp)
APP_URL=https://gruas-rhino.vercel.app
# Vercel Cron manda "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Salidas de almacén por arriba de este monto requieren autorización
INVENTORY_AUTHORIZE_ABOVE_MXN=5000
